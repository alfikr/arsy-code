name: Release build

on:
  push:
    tags: ["v[0-9]+.[0-9]+.[0-9]+"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-latest
            target: x86_64-unknown-linux-gnu
            exe: ""
          - runner: ubuntu-24.04-arm
            target: aarch64-unknown-linux-gnu
            exe: ""
          - runner: macos-15-intel
            target: x86_64-apple-darwin
            exe: ""
          - runner: macos-latest
            target: aarch64-apple-darwin
            exe: ""
          - runner: windows-latest
            target: x86_64-pc-windows-msvc
            exe: .exe
    runs-on: ${{ matrix.runner }}
    name: ${{ matrix.target }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
      - run: rustup toolchain install 1.85.0 --profile minimal
      - run: cargo +1.85.0 build --workspace --all-features --locked --release
      - name: Generate CycloneDX SBOM
        run: |
          cargo +1.85.0 install cargo-cyclonedx --version 0.5.9 --locked
          cargo +1.85.0 cyclonedx --all --format json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: arsy-${{ matrix.target }}
          path: |
            target/release/arsy${{ matrix.exe }}
            **/*.cdx.json
          if-no-files-found: error
