name: npm-publish

on:
  workflow_run:
    workflows: ["Release build"]
    types: [completed]
  workflow_call:
    inputs:
      tag:
        description: Git tag that was released (e.g. v0.1.1)
        required: true
        type: string
  workflow_dispatch:
    inputs:
      tag:
        description: Existing release tag to publish to npm (e.g. v0.1.1)
        required: true
        type: string

permissions:
  contents: read

jobs:
  publish:
    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: ${{ inputs.tag || github.event.workflow_run.head_sha }}
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          registry-url: "https://registry.npmjs.org"
      - name: Verify release tag matches package version
        shell: bash
        run: |
          tag="${{ inputs.tag || github.event.workflow_run.head_branch }}"
          package_version="$(node -p "require('./package.json').version")"
          test "$tag" = "v$package_version"
      - uses: actions/download-artifact@v4
        with:
          path: dist
          pattern: arsy-*
          github-token: ${{ secrets.GITHUB_TOKEN }}
          run-id: ${{ github.event.workflow_run.id }}
      # Trusted Publishing (OIDC): no NPM_TOKEN needed. Requires npm >= 11.5.1
      # and this exact workflow path registered as a Trusted Publisher on
      # npmjs.com for @suiflex/arsy-code and for each @suiflex/arsy-code-<platform>
      # package below.
      - run: npm install -g npm@latest

      # One npm package per Rust target, each staged from that target's release
      # binary, published under its own name (docs/34-distribution.md). The
      # optionalDependencies in package.json can only resolve once every
      # platform package listed there is live, so all five publish before
      # the launcher does.
      - name: Stage and publish platform packages
        shell: bash
        run: |
          set -euo pipefail
          version="${{ inputs.tag || github.event.workflow_run.head_branch }}"
          version="${version#v}"
          declare -A targets=(
            [x86_64-unknown-linux-gnu]=arsy
            [aarch64-unknown-linux-gnu]=arsy
            [x86_64-apple-darwin]=arsy
            [aarch64-apple-darwin]=arsy
            [x86_64-pc-windows-msvc]=arsy.exe
          )
          for target in "${!targets[@]}"; do
            binary="dist/arsy-${target}/target/release/${targets[$target]}"
            test -f "$binary"
            output="npm/platforms/${target}"
            npm run stage:platform -- \
              --target "$target" \
              --binary "$binary" \
              --version "$version" \
              --output "$output"
            npm publish --access public "$output"
          done

      - name: Publish the launcher package
        run: npm publish --access public
